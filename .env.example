# Jira
JIRA_BASE=https://yourorg.atlassian.net
# JIRA_API_BASE only needed for service-account tokens (which only work via the gateway URL).
# When unset, falls back to JIRA_BASE — leave commented for personal API tokens.
# JIRA_API_BASE=https://api.atlassian.com/ex/jira/<cloud-id>
JIRA_USER=you@example.com
JIRA_TOKEN=your_jira_api_token

# Jira custom fields
PRODUCT_FIELD_ID=customfield_11675
TIME_FIELD_ID=customfield_11609

# Grafana
GRAFANA_HOST=grafana.example.com
GRAFANA_UID=your_dashboard_uid
GRAFANA_SLUG=your-dashboard-slug

# Time window (ms)
PRE_MS=120000
POST_MS=60000

# Webhook auth (optional)
WEBHOOK_SECRET=change_me

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Jira issue creation defaults
JIRA_DEFAULT_PROJECT=RIM
JIRA_DEFAULT_ISSUE_TYPE=Robot Issue
JIRA_FALLBACK_ACCOUNT_ID=your-service-account-jira-id
